# ============================================================
# Credenciales del proyecto — copia este fichero como .env
# y rellena los valores antes de ejecutar 'make setup'
# ============================================================

# PostgreSQL (backend de Airflow y Hive Metastore)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto

# MinIO (almacenamiento S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia_esto

# Airflow — genera una clave con:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=cambia_esto
